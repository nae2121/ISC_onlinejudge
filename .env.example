# App database used by backend_migrate, backend_api, and judge_worker in docker-compose.yml.
APP_DATABASE_URL=postgres://onlinejudge:onlinejudge@app_db:5432/onlinejudge?sslmode=disable

# Use this URL from the host machine, for example with psql/goose/sqlc helper scripts.
APP_DATABASE_URL_LOCAL=postgres://onlinejudge:onlinejudge@localhost:5433/onlinejudge?sslmode=disable

# Next.js API route handlers proxy browser requests to the Go backend.
BACKEND_API_URL=http://localhost:8080

# PIN required for user registration. Admin users can view this in the admin UI.
APP_REGISTRATION_PIN_CODE=1234
